{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Syncloop Flow テスト設計データ",
  "type": "object",
  "required": ["approval_status", "target", "requirements", "viewpoints", "test_cases", "unresolved_items"],
  "properties": {
    "approval_status": {"const": "approved"},
    "target": {"type": "object", "required": ["name", "version", "test_level"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "test_level": {"const": "画面ブラックボックステスト"}}},
    "requirements": {"type": "array", "minItems": 1},
    "viewpoints": {"type": "array"},
    "test_cases": {"type": "array", "maxItems": 50},
    "unresolved_items": {"type": "array"}
  }
}
